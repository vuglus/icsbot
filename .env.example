# Database
DB_PROVIDER=sqlite
DB_PATH=icsbot.db
DB_ENDPOINT=

# API
API_KEY=your-api-key-here
EXT_PORT=8080

# Calendar type is passed in request body when creating a calendar

# Chat bot integration
TG_BOT_URL=http://tg-bot:8080
TG_BOT_TOKEN=your-tg-bot-token

# Notifications
NOTIFY_BEFORE_MINUTES=15

# Timezone
TIMEZONE_DEFAULT=UTC
